{
  "version": 2,
  "functions": {
    "app/main.py": {
      "excludeFiles": "{tests/**,testdata/**,static/**,assets/**,**/*.mp3,**/*.wav,**/*.mp4}"
    }
  },
  "routes": [
    {
      "src": "/vca/(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/docs",
      "dest": "app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}