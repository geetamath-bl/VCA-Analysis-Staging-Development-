{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "vca-without-azure-stt/app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/vca/(.*)",
      "dest": "vca-without-azure-stt/app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}