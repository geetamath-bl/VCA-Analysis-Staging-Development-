{
  "version": 2,
  "builds": [
    {
      "src": "vca_code/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["bin/ffmpeg", "frontend/**"],
        "excludeFiles": "{**/tests/**,**/test/**,**/testing/tests/**,vca_code/test_*.py,audio_files/**,json_output/**,transcript/**,log/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "vca_code/main.py"
    }
  ]
}