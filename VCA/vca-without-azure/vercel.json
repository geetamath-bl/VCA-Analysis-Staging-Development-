{
  "version": 2,
  "functions": {
    "app/main.py": {
      "excludeFiles": "{tests/**,testdata/**,static/**,assets/**,**/*.mp3,**/*.wav,**/*.mp4}"
    }
  },
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/vca/(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/docs",
      "dest": "app/main.py"
    },
    {
      "src": "/",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}