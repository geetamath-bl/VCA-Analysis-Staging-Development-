{
  "version": 2,
  "functions": {
    "vca_code/main.py": {
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "vca_code/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/vca/(.*)",
      "dest": "/vca_code/main.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/vca_code/main.py"
    }
  ]
}