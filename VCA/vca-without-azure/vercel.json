{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "vca_code/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/vca/(.*)",
      "dest": "vca_code/main.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    }
  ]
}